# === BẮT BUỘC: Telegram & AI ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (Tùy chọn) Gửi cảnh báo lỗi sang nhóm/chat riêng; để trống sẽ gửi cùng TELEGRAM_CHAT_ID
TELEGRAM_ALERT_CHAT_ID=

GEMINI_API_KEY=
# (Tùy chọn) Dự phòng khi toàn bộ model Gemini lỗi/hết quota
OPENROUTER_API_KEY=

# === RSSHUB & X (TWITTER) / THREADS ===
# Lấy cookie "auth_token" từ x.com bằng tài khoản X PHỤ.
# Mẹo chống gián đoạn: có thể nhập nhiều token cách nhau bằng dấu phẩy để RSSHub tự xoay vòng:
# TWITTER_AUTH_TOKEN=token_acc_phu_1,token_acc_phu_2
TWITTER_AUTH_TOKEN=

# === TÙY CHỌN: BROWSERLESS (Chỉ bật nếu cần render JS nặng & VPS đã tạo Swap) ===
# Mặc định để trống để tiết kiệm RAM cho VPS 1GB.
# Nếu muốn bật: điền 2 dòng dưới và chạy `docker compose --profile browser up -d`
# BROWSERLESS_TOKEN=change-me-to-random-string
# PLAYWRIGHT_CDP_ENDPOINT=ws://browserless:3000?token=change-me-to-random-string

# Thời gian cache của RSSHub (giây) - mặc định 1800s (30 phút)
RSSHUB_CACHE_EXPIRE=1800

# === LỊCH CHẠY & HÀNH VI BOT ===
TZ=Asia/Ho_Chi_Minh
# Mặc định: 06:17, 14:17, 22:17 mỗi ngày theo giờ VN
CRON_SCHEDULE=17 6,14,22 * * *
# true = chạy ngay 1 phiên khi vừa khởi động container
RUN_ON_STARTUP=false
# true = gửi cảnh báo về Telegram khi RSSHub/X/Threads/Bot lỗi
SEND_ERROR_ALERTS=true
FETCH_TIMEOUT=25
FETCH_RETRIES=2
